# Ubuntu Handheld / Gaming Console defaults
# These overrides apply to all users on handheld devices

# GTK3/GTK4 prefer dark style and 12h clock
[org.gnome.desktop.interface]
gtk-theme = 'Yaru-dark'
icon-theme = 'Yaru-dark'
color-scheme = 'prefer-dark'
clock-format = '12h'

[org.gnome.desktop.interface:ubuntu-handheld]
gtk-theme = 'Yaru-dark'
icon-theme = 'Yaru-dark'
cursor-theme = 'Yaru'
font-name = 'Ubuntu Sans 11'
monospace-font-name = 'Ubuntu Sans Mono 11'
document-font-name = 'Sans 11'
font-antialiasing = 'rgba'
color-scheme = 'prefer-dark'

# Ubuntu Handheld Shell launcher defaults
[com.ubuntu.HandheldShell]
sort-order='curated'
show-all-apps=false

# Window manager preferences: drop titlebar button controls and titlebar click actions
[org.gnome.desktop.wm.preferences]
button-layout = ''
action-double-click-titlebar = 'none'
action-middle-click-titlebar = 'none'
action-right-click-titlebar = 'none'

[org.gnome.desktop.wm.preferences:ubuntu-handheld]
button-layout = ''
action-double-click-titlebar = 'none'
action-middle-click-titlebar = 'none'
action-right-click-titlebar = 'none'
