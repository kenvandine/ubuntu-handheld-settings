# Ubuntu Handheld / Gaming Console dark mode defaults
# These overrides apply to all users on handheld devices

# GTK3/GTK4 prefer dark style
[org.gnome.desktop.interface]
gtk-theme-name='Yaru-dark'
icon-theme-name='Yaru-dark'
prefer-dark-theme=true

# Terminal prefer dark style
[org.gnome.Terminal]
prefer-dark-theme=true
